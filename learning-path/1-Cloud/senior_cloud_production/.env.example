# ── Application ───────────────────────────────────────────────────────────
APP_NAME=senior-cloud-api
APP_VERSION=1.0.0
APP_ENV=production          # development | production
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand
POSTGRES_DB=appdb

# ── Docker image (used by docker-compose.prod.yml) ────────────────────────
DOCKER_IMAGE=your-dockerhub-user/senior-cloud-api
IMAGE_TAG=latest

# ── Domain (must match nginx.conf and Certbot) ────────────────────────────
DOMAIN=your-domain.com

# ── Dozzle log viewer ─────────────────────────────────────────────────────
DOZZLE_USER=admin
DOZZLE_PASSWORD=CHANGE_ME_dozzle_password
