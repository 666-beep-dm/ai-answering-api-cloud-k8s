# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_PORT=8000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=fileservice
DB_USER=postgres
DB_PASSWORD=strongpassword123

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT_URL=http://minio:9000        # use https://s3.amazonaws.com for AWS
S3_BUCKET_NAME=enterprise-files
S3_REGION=us-east-1

# ── Upload constraints ────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
PRESIGNED_UPLOAD_TTL=900
PRESIGNED_DOWNLOAD_TTL=3600
S3_RETRY_ATTEMPTS=3
