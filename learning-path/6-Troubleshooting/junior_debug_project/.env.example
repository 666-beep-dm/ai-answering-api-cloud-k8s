# Скопируйте в .env и измените значения под свои нужды.

# ── Режим работы ──────────────────────────────────────────────────────
# true  → эндпоинт /users бросает 500 (KeyError) — режим воспроизведения бага
# false → исправленный вариант, возвращает корректный список пользователей
BUG_MODE=true

# ── Уровень логирования ───────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
