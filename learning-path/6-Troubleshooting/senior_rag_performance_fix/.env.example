# ── App ───────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
WORKERS=2

# ── Vector Store ──────────────────────────────────────────────────────
VECTOR_DIM=384
VECTOR_CORPUS_SIZE=5000
TOP_K=5

# ── LLM ───────────────────────────────────────────────────────────────
LLM_API_URL=http://mock-llm:8080/generate
LLM_TIMEOUT_FIX=30.0

# ── Bottleneck simulation (set high to reproduce bug, low for fix) ────
SIMULATE_BLOCKING_IO_SECONDS=0.05
SIMULATE_LLM_DELAY_SECONDS=0.1
