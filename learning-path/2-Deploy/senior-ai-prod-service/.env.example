# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=RAG AI Service
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=CHANGE_ME_32_CHAR_SECRET

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=ragdb
DATABASE_URL=postgresql+asyncpg://appuser:CHANGE_ME_STRONG_PASSWORD@db:5432/ragdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true
