# ── Logging ───────────────────────────────────────────────────────────────
# Verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Write logs to ./logs/app.log in addition to stdout
# true | false
LOG_TO_FILE=false

# Log file path (relative to the working directory inside the container)
LOG_FILE=logs/app.log
