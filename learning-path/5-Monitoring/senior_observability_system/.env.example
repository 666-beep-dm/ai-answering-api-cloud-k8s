# ── Application ───────────────────────────────────────────────────────────
APP_NAME=SeniorObservabilityService
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_TO_FILE=false
LOG_FILE=logs/app.log

# ── OpenTelemetry Tracing ─────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=fastapi-observability
OTEL_EXPORTER=console            # console | otlp
OTEL_OTLP_ENDPOINT=http://localhost:4317

# ── Prometheus Metrics ────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ── Alerting thresholds ───────────────────────────────────────────────────
ALERT_ERROR_RATE_THRESHOLD=0.05  # 5%  — fires CRITICAL log
ALERT_LATENCY_THRESHOLD_MS=500   # ms  — fires CRITICAL log
ALERT_WINDOW_SECONDS=60
