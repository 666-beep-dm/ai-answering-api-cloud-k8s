# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-real-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=aidb

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
API_TOKEN_SECRET=change_me_to_random_secret_32_chars

# DATABASE_URL строится автоматически в docker-compose из переменных выше.
# Для локального запуска без Docker раскомментируйте и заполните:
# DATABASE_URL=postgresql+asyncpg://aiuser:password@localhost/aidb
