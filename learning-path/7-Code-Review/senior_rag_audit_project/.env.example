# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-real-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ragdb
DATABASE_URL=postgresql+asyncpg://raguser:change_me_strong_password@db/ragdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# ── App Security ──────────────────────────────────────────────────────────────
API_TOKEN_SECRET=generate_32_char_random_string_here

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=rag-api
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ── Semantic Cache ────────────────────────────────────────────────────────────
SEMANTIC_CACHE_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
