# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# Set to true to bypass real LLM calls (local testing without a key)
USE_MOCK=false

# ── S3-compatible storage ──────────────────────────────────────────────────────
# Leave S3_ENDPOINT_URL empty for real AWS S3.
# For Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
# For Selectel:       https://s3.selectel.ru
# For MinIO (local):  http://minio:9000
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=ai-answering-api
S3_REGION=us-east-1

# ── RAG settings ───────────────────────────────────────────────────────────────
VECTOR_DB_PATH=./vector_db
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_CHUNKS=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Limits ─────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
