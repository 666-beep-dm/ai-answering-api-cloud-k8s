# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
SECRET_KEY=supersecretkey

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
USE_MOCK=false              # true → no real API calls needed

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_api
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# ── S3-compatible Storage ─────────────────────────────────────────────────────
S3_ENDPOINT_URL=           # empty = real AWS; set for R2/Selectel/MinIO
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=ai-answering-api
S3_REGION=us-east-1

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=vector-db
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── RAG ───────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_CHUNKS=3
MAX_FILE_SIZE_MB=10

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
